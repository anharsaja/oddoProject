# ---------------------------------------------------------------------------
# Oddo ERP — development environment
#
# Copy this file to .env before starting anything:
#     POSIX : cp .env.example .env
#     PowerShell : Copy-Item .env.example .env
#
# Every variable below is REQUIRED. The API validates them with zod at boot and
# refuses to start if any is missing or malformed (PRD-000 BR-INFRA-001).
# ---------------------------------------------------------------------------

# --- apps/api --------------------------------------------------------------
NODE_ENV=development
PORT=3001
# Host port is 5433, not 5432 — see docker-compose.yml
DATABASE_URL=postgresql://oddo:oddo@localhost:5433/oddo_dev?schema=public
# Redis database index 0 is development; index 1 belongs to the tests
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# --- apps/web --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api
