# ---------------------------------------------------------------------------
# Oddo ERP — integration test environment (committed on purpose).
#
# Loaded automatically by the Jest setup in apps/api. Identical to
# .env.example except for the two values that keep tests away from the
# development data: database oddo_test and Redis index 1.
# NODE_ENV is "test" so the pretty log transport stays off while testing.
# ---------------------------------------------------------------------------

# --- apps/api --------------------------------------------------------------
NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://oddo:oddo@localhost:5433/oddo_test?schema=public
REDIS_URL=redis://localhost:6379/1
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=warn

# --- apps/web --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- session policy --------------------------------------------------------
SESSION_IDLE_TTL_MINUTES=120
SESSION_ABSOLUTE_TTL_HOURS=8

# --- first administrator ---------------------------------------------------
ADMIN_EMAIL=admin@oddo.local
ADMIN_PASSWORD=ChangeMe!2026
