// Oddo ERP — database schema
//
// Conventions that bind every model added from here on (ADR-0001):
//   B3  ids are UUID v7 generated in the application layer, never by the
//       database — so a parent and its children can be built in one round trip
//   B4  money  -> Decimal @db.Decimal(18, 4)
//       amounts/quantities -> Decimal @db.Decimal(18, 6)
//       never Float, anywhere, for either
//   B5  every point in time -> DateTime @db.Timestamptz(6), stored in UTC
//
// Business tables additionally carry the base fields of ADR-0002 §4
// (company_id, created_by, updated_by, active). `system_setting` below is not
// a business table and deliberately has none of them — see PRD-000 §7.2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Instance-level configuration. Managed by seeds and migrations, not by users
/// through a screen, and referenced by no document.
model SystemSetting {
  id          String   @id @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       Json     @db.JsonB
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_setting")
}

/// A legal entity. Every business table hangs off one of these (ADR-0002 §2);
/// `company` itself carries no company_id because it *is* the company.
model Company {
  id          String   @id @db.Uuid
  name        String   @db.VarChar(200)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?  @map("updated_by") @db.Uuid

  createdBy User?  @relation("CompanyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?  @relation("CompanyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  users     User[] @relation("UserCompany")

  @@map("company")
}

/// Someone who can log in. `email` is the login identity and is unique across
/// the whole instance, not per company (BR-AUTH-007): the login form has no
/// company picker, so a duplicated email would make "who is logging in"
/// ambiguous.
///
/// `created_by` and `updated_by` are nullable, unlike the general rule in
/// ADR-0002 §4. NULL has exactly one documented meaning here: created by the
/// system seed. The first administrator is created by nobody, and inventing a
/// creator would be worse than recording the truth.
model User {
  id           String    @id @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.Text
  name         String    @db.VarChar(200)
  isSuperadmin Boolean   @default(false) @map("is_superadmin")
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById  String?   @map("updated_by") @db.Uuid

  company   Company @relation("UserCompany", fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?   @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  createdUsers     User[]    @relation("UserCreatedBy")
  updatedUsers     User[]    @relation("UserUpdatedBy")
  createdCompanies Company[] @relation("CompanyCreatedBy")
  updatedCompanies Company[] @relation("CompanyUpdatedBy")

  @@index([companyId])
  @@map("user")
}
