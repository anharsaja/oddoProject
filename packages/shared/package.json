{
  "name": "@oddo/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types, enums and constants shared by @oddo/api and @oddo/web",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
